# Copy to .env and adjust. Both the Next.js app and the sync server read it.

# --- Web app (Next.js) -------------------------------------------------------
# URL of the sync server, as seen from the browser. Inlined at build time.
# Default when unset: ws://<page hostname>:1234 (wss:// on https pages).
NEXT_PUBLIC_WS_URL=ws://localhost:1234

# --- Sync server (server/index.ts) -------------------------------------------
# Port of the WebSocket server.
PORT=1234
# SQLite file where boards are stored (created if missing).
DB_PATH=data/live-board.sqlite
# Delay before writing a board to disk after a change, in milliseconds.
SAVE_DEBOUNCE_MS=1000
